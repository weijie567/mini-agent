{
  "mode": "interactive",
  "granularity": "standard",
  "model_profile": "quality",
  "commit_docs": true,
  "response_language": "Chinese",
  "parallelization": false,
  "phase_naming": "sequential",
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ai_integration_phase": false,
    "ui_phase": false,
    "tdd_mode": true,
    "text_mode": true,
    "use_worktrees": false,
    "inline_plan_threshold": 0,
    "code_review": true,
    "code_review_depth": "deep",
    "pattern_mapper": true,
    "auto_prune_state": false
  },
  "git": {
    "branching_strategy": "none",
    "base_branch": "integration/e2e01-cycle2"
  },
  "planning": {
    "commit_docs": true,
    "search_gitignored": false
  },
  "hooks": {
    "context_warnings": true
  },
  "graphify": {
    "enabled": true,
    "build_timeout": 300
  },
  "claude_md_path": "./CLAUDE.md"
}
