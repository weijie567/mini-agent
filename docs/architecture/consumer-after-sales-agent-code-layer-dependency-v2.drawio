        <mxCell id="composition_root" value="&lt;b&gt;Bootstrap / Composition Root&lt;/b&gt;&lt;br&gt;&lt;br&gt;唯一允许同时引用 Port 与具体 Adapter 的位置&lt;br&gt;&lt;br&gt;创建对象 · 注入依赖 · 加载配置&lt;br&gt;选择 Mock / Real 实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=1.8;fontColor=#9A3412;fontSize=13;align=left;verticalAlign=top;spacing=16;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1570" y="275" width="355" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="allowed_rules" value="&lt;b&gt;✓ 允许依赖&lt;/b&gt;&lt;br&gt;&lt;br&gt;Inbound Adapter → Inbound Port&lt;br&gt;&lt;br&gt;Application → Core&lt;br&gt;&lt;br&gt;Outbound Adapter → Application-owned / Core-owned Port&lt;br&gt;&lt;br&gt;Adapter → 外部 SDK / Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.8;fontColor=#065F46;fontSize=13;align=left;verticalAlign=top;spacing=16;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1570" y="495" width="355" height="245" as="geometry"/>
        </mxCell>

        <mxCell id="forbidden_rules" value="&lt;b&gt;✕ 禁止依赖&lt;/b&gt;&lt;br&gt;&lt;br&gt;Core ⇢ Concrete Adapter / Framework&lt;br&gt;&lt;br&gt;Core ⇢ DB / HTTP / LLM SDK&lt;br&gt;&lt;br&gt;Application ⇢ 具体 DB / 外部 API&lt;br&gt;&lt;br&gt;Inbound Adapter ⇢ Runtime 内部组件&lt;br&gt;&lt;br&gt;Adapter ⇢ 另一个 Adapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.8;dashed=1;dashPattern=7 5;fontColor=#991B1B;fontSize=13;align=left;verticalAlign=top;spacing=16;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1570" y="770" width="355" height="285" as="geometry"/>
        </mxCell>

        <mxCell id="tool_definition_note" value="&lt;b&gt;Tool Definition ≠ Port ≠ Adapter&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tool Definition：Agent 可见的名称、描述与 Schema&lt;br&gt;Port：Application / Core 按职责定义的代码接口&lt;br&gt;Adapter：Port 的具体技术实现&lt;br&gt;&lt;br&gt;Port 按 owner、事务和测试边界拆分；不要求“一种记录＝一张表＝一个 Port”。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A78BFA;strokeWidth=1.6;fontColor=#5B21B6;fontSize=11;align=left;verticalAlign=top;spacing=15;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1570" y="1070" width="355" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="bottom_rule" value="核心规则：所有外部变化在 Adapter 层停止；Application / Core 只看到各自拥有的 Port；运行时调用方向与源代码依赖方向可以相反。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=13;fontStyle=1;arcSize=24;" vertex="1" parent="1">
          <mxGeometry x="120" y="1305" width="1770" height="44" as="geometry"/>
        </mxCell>

