<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="Codex" version="29.0.3">
  <diagram id="e2e-order-resolution-v2" name="01 订单定位与按需查询">
    <mxGraphModel dx="2100" dy="2500" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="2100" pageHeight="2500" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="e1_0"/>
        <mxCell id="e1_1" parent="e1_0"/>

        <mxCell id="e1_title" value="E2E-01 · 订单定位、物流查询与配送异常判断" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="e1_1">
          <mxGeometry x="70" y="28" width="1300" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="e1_subtitle" value="从用户自然语言或显式标识开始，经可信身份、本人资源定位、动态工具选择和披露控制，形成安全答复" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#475569;" vertex="1" parent="e1_1">
          <mxGeometry x="70" y="74" width="1450" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="e1_legend" value="蓝色＝用户与可信身份　绿色＝只读工具 / 已验证事实　紫色＝动态业务决策　灰色＝安全退出　虚线＝下一轮恢复" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#F8FAFC;fontSize=12;fontColor=#475569;align=left;spacingLeft=18;" vertex="1" parent="e1_1">
          <mxGeometry x="70" y="116" width="1960" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="e1_start" value="用户提出请求&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;“帮我看一下最近买的那双鞋” / “O-1001 到哪了？”&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=15;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="760" y="195" width="590" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="e1_context" value="验证 Session / JWT 并装载可信 CustomerContext&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;customer_id 仅由服务端注入，用户和模型均不可覆盖&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=15;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="760" y="330" width="590" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1_understand" value="Request Understanding&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;识别目标、对象描述，以及是否询问订单 / 物流 / 配送异常&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=15;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="760" y="465" width="590" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1_source" value="本人订单如何定位？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=15;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="895" y="600" width="320" height="145" as="geometry"/>
        </mxCell>

        <mxCell id="e1_search_orders" value="调用 search_orders&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;customer_id + 时间范围 + 商品名称 / 类别&lt;br&gt;只检索当前用户本人订单&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=15;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="390" y="810" width="480" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="e1_get_order_initial" value="调用 get_order&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;(server customer_id, user order_id)&lt;br&gt;在业务 API 内原子校验归属&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=15;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="1220" y="810" width="490" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="e1_order_result" value="本人订单定位结果？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=15;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="895" y="985" width="320" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="e1_order_result_merge" value="" style="ellipse;html=1;fillColor=none;strokeColor=none;opacity=0;resizable=0;movable=0;connectable=1;" vertex="1" parent="e1_1">
          <mxGeometry x="1055" y="950" width="0" height="0" as="geometry"/>
        </mxCell>
        <mxCell id="e1_ask_candidate" value="ASK_USER · 请确认候选商品&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;仅展示本人订单中的最小必要摘要，不泄露无关字段&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=14;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="150" y="1000" width="450" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="e1_wait_candidate" value="本轮结果 ASK_USER · Task = WAITING_USER&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#64748B&quot;&gt;用户确认后恢复同一个 RequestUnit / Task&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontSize=14;fontStyle=1;fontColor=#334155;strokeWidth=1.8;" vertex="1" parent="e1_1">
          <mxGeometry x="190" y="1125" width="370" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="e1_safe_not_found" value="RunResultMapper 返回统一安全答复&lt;br&gt;&lt;b&gt;NOT_FOUND_OR_NOT_ACCESSIBLE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;不区分不存在与非本人订单；不返回商品、地址、支付或物流信息&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontSize=14;fontColor=#334155;strokeWidth=1.8;" vertex="1" parent="e1_1">
          <mxGeometry x="120" y="1270" width="500" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="e1_bind_order" value="绑定已验证的本人订单与商品&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;OrderRef / LineItemRef 进入 ModelVisibleContext 的最小投影&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=15;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="760" y="1180" width="590" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1_goal" value="用户当前真正需要什么？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=15;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="875" y="1320" width="360" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="e1_order_details" value="按需获取本人订单详情&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;商品名称 · 订单号 · 订单状态&lt;br&gt;未询问物流则不调用 get_shipment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=14;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="390" y="1555" width="470" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="e1_shipment" value="调用 get_shipment&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;仅在用户询问位置、ETA 或配送异常时执行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=15;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="1200" y="1555" width="490" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1_need_diagnosis" value="需要配送异常诊断？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFF7ED;fontSize=14;fontStyle=1;fontColor=#C2410C;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="1300" y="1715" width="290" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="e1_diagnose" value="DeliverySignalEvaluator&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;延迟 · 停滞 · 签收未收到 · 事实不足&lt;br&gt;只基于已验证物流轨迹和时间&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFF7ED;fontSize=14;fontStyle=1;fontColor=#9A3412;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="1200" y="1890" width="490" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e1_mapper_merge_left" value="" style="ellipse;html=1;fillColor=none;strokeColor=none;opacity=0;resizable=0;movable=0;connectable=1;" vertex="1" parent="e1_1">
          <mxGeometry x="625" y="2050" width="0" height="0" as="geometry"/>
        </mxCell>
        <mxCell id="e1_mapper_merge" value="" style="ellipse;html=1;fillColor=none;strokeColor=none;opacity=0;resizable=0;movable=0;connectable=1;" vertex="1" parent="e1_1">
          <mxGeometry x="1055" y="2050" width="0" height="0" as="geometry"/>
        </mxCell>
        <mxCell id="e1_mapper_merge_right" value="" style="ellipse;html=1;fillColor=none;strokeColor=none;opacity=0;resizable=0;movable=0;connectable=1;" vertex="1" parent="e1_1">
          <mxGeometry x="1445" y="2050" width="0" height="0" as="geometry"/>
        </mxCell>

        <mxCell id="e1_mapper" value="Result Processing + Outbound Disclosure Gate + RunResultMapper&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;已验证订单 / 物流事实 → Observation；安全失败 → RunResultMapper；调用失败 → Trace&lt;br&gt;配送异常结论记录为 Deterministic Derivation；Task Working Context 仅更新 refs / 最小投影&lt;br&gt;同步 Conversation / Context Manifest；安全映射本轮结果并执行字段白名单和最小披露&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0F766E;fillColor=#F0FDFA;fontSize=15;fontStyle=1;fontColor=#115E59;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="650" y="2110" width="810" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="e1_end" value="回复用户&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;本人订单摘要 / 按需物流与异常 / 统一安全答复&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=15;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="e1_1">
          <mxGeometry x="760" y="2290" width="590" height="92" as="geometry"/>
        </mxCell>

        <mxCell id="e1_rules" value="&lt;b&gt;E2E-01 不可绕过的边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;① customer_id 仅来自可信 CustomerContext&lt;br&gt;&lt;br&gt;② 所有私有查询先限定 customer_id 范围&lt;br&gt;&lt;br&gt;③ 多候选仅展示本人订单最小摘要&lt;br&gt;&lt;br&gt;④ 不存在与非本人订单使用统一外部结果&lt;br&gt;&lt;br&gt;⑤ 非本人订单不得泄露商品身份或订单内容&lt;br&gt;&lt;br&gt;⑥ 物流和异常诊断都是按需分支，不是固定顺序" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#94A3B8;fillColor=#FFFFFF;fontSize=13;fontColor=#334155;align=left;verticalAlign=top;spacing=18;strokeWidth=1.8;arcSize=18;" vertex="1" parent="e1_1">
          <mxGeometry x="1490" y="205" width="510" height="490" as="geometry"/>
        </mxCell>

        <mxCell id="e1_e_start_context" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="e1_1" source="e1_start" target="e1_context"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_e_context_understand" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="e1_1" source="e1_context" target="e1_understand"><mxGeometry relative="1" as="geometry"/></mxCell>
