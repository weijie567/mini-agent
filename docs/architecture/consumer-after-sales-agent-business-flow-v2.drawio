        <mxCell id="e1_e_mapper_right_bus" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0F766E;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="e1_1" source="e1_mapper_merge_right" target="e1_mapper_merge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_e_mapper_bus_gate" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0F766E;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="e1_1" source="e1_mapper_merge" target="e1_mapper"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_e_mapper_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="e1_1" source="e1_mapper" target="e1_end"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="e2e-refund-control-v2" name="02 退款资格与受控恢复">
    <mxGraphModel dx="2100" dy="3400" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="2100" pageHeight="3400" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="e2_0"/>
        <mxCell id="e2_1" parent="e2_0"/>

        <mxCell id="e2_title" value="E2E-02 · 退款资格、受控模拟执行与结果恢复" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="e2_1">
          <mxGeometry x="70" y="28" width="1300" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="e2_subtitle" value="读操作按需收集事实；资格判断、精确确认、ActionPolicy、幂等执行与未知结果恢复保持确定性" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#475569;" vertex="1" parent="e2_1">
          <mxGeometry x="70" y="74" width="1450" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="e2_legend" value="蓝色＝用户与可信身份　绿色＝事实 / Evidence　紫色＝业务决策与恢复　橙色＝受控写操作　红色＝禁止执行　虚线＝下一轮恢复 / 对账" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#F8FAFC;fontSize=12;fontColor=#475569;align=left;spacingLeft=18;" vertex="1" parent="e2_1">
          <mxGeometry x="70" y="116" width="1960" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="e2_start" value="用户提出退款相关请求&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;资格咨询 / 创建模拟退款 / 查询状态 / 恢复未知结果&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=15;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="760" y="195" width="590" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="e2_context" value="验证 Session / JWT 并装载可信 CustomerContext&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;customer_id、授权范围和执行主体保持 Runtime 私有&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=15;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="760" y="330" width="590" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e2_understand" value="Request Understanding&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;识别本轮目标、订单 / 商品 / 退款指代以及依赖条件&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=15;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="760" y="465" width="590" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e2_resolve" value="定位本人订单、商品或退款记录&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;复用 E2E-01 的自然语言定位、候选确认与 (customer_id, resource_id) 归属校验&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=15;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="710" y="600" width="690" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="e2_owned" value="本人资源定位成功？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=15;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="900" y="745" width="310" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="e2_safe_denial" value="RunResultMapper 返回统一安全答复&lt;br&gt;&lt;b&gt;NOT_FOUND_OR_NOT_ACCESSIBLE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;停止私有数据读取与动作路径，不泄露资源是否存在&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontSize=14;fontColor=#334155;strokeWidth=1.8;" vertex="1" parent="e2_1">
          <mxGeometry x="130" y="760" width="500" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e2_goal" value="本轮退款目标？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=15;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="900" y="930" width="310" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="e2_status_query" value="调用 get_refund_status&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;使用本人 refund_id，或原 execution / idempotency identity&lt;br&gt;不创建新的退款动作&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="1460" y="1110" width="500" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="e2_status_result" value="退款状态 / 对账结果&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;已验证退款状态 → Observation；状态变化 / 对账 → Action Ledger；调用失败 → Trace / 安全本轮结果&lt;br&gt;动作状态保持 PROCESSING / COMPLETED / FAILED / RESULT_UNKNOWN&lt;br&gt;RunResultMapper 仅映射 Agent 本轮结果；仍未知时保持可恢复，不伪报成功或失败&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="1460" y="1250" width="500" height="125" as="geometry"/>
        </mxCell>

        <mxCell id="e2_evidence" value="按需收集 Observation 与 Evidence&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;订单事实 · 必要物流 → Observation；调用 retrieve_refund_policy → Evidence Binding&lt;br&gt;既有退款状态按需复核；单纯状态查询不强制重查物流或政策&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=15;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="710" y="1110" width="690" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="e2_evidence_valid" value="Observation 新鲜且&lt;br&gt;Evidence 完整、适用、无冲突？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="905" y="1270" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="e2_refresh" value="刷新 / 补齐必要 Observation 与 Evidence&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;仅补查缺口；达到预算仍不满足，由 RunResultMapper 返回 BLOCKED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontSize=14;fontStyle=1;fontColor=#334155;strokeWidth=1.8;" vertex="1" parent="e2_1">
          <mxGeometry x="140" y="1285" width="480" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e2_eligibility_eval" value="RefundEligibilityEvaluator&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;基于已验证事实与适用政策进行确定性判断&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=15;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="760" y="1460" width="590" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e2_eligibility" value="资格判断结果？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=15;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="905" y="1600" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="e2_not_eligible" value="NOT_ELIGIBLE · RunResultMapper 回复&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;解释政策依据和允许的替代方案；不进入执行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#DC2626;fillColor=#FEF2F2;fontSize=14;fontStyle=1;fontColor=#991B1B;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="130" y="1620" width="470" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e2_undetermined" value="UNDETERMINED · RunResultMapper 回复&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;Observation / Evidence 不足、冲突或系统不可用；禁止退款并说明缺口&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontSize=14;fontStyle=1;fontColor=#334155;strokeWidth=1.8;" vertex="1" parent="e2_1">
          <mxGeometry x="1480" y="1620" width="470" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="e2_proposal" value="生成不可变模拟退款方案并写入 Action Ledger&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;PROPOSED → AWAITING_CONFIRMATION；订单 · 商品 · 数量 · 金额 · 方式 · 影响&lt;br&gt;绑定关键 Observation / Evidence 版本 · expires_at&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFF7ED;fontSize=15;fontStyle=1;fontColor=#9A3412;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="710" y="1790" width="690" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="e2_confirm" value="用户是否精确确认&lt;br&gt;同一个方案？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=14;fontStyle=1;fontColor=#1D4ED8;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="900" y="1935" width="310" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="e2_ask_confirm" value="ASK_USER · 展示确认摘要&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;明确订单、商品、数量、金额、方式和影响；关键输入变化后原确认失效&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=14;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="130" y="1930" width="500" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="e2_wait_confirm" value="本轮结果 ASK_USER · Task = WAITING_USER&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#64748B&quot;&gt;未确认 / 含糊：AWAITING_CONFIRMATION；提案过期：INVALIDATED；均零执行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontSize=14;fontStyle=1;fontColor=#334155;strokeWidth=1.8;" vertex="1" parent="e2_1">
          <mxGeometry x="130" y="2065" width="500" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="e2_action_policy" value="ActionPolicy · 执行时重新裁决&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;归属与授权 · 关键 Observation 版本 / 新鲜度&lt;br&gt;Evidence 完整 / 适用 / 新鲜 · 数量等方案参数 · 精确确认 · 重复退款 · 幂等前提&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFF7ED;fontSize=15;fontStyle=1;fontColor=#9A3412;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="710" y="2130" width="690" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="e2_gate" value="Gate Decision？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFF7ED;fontSize=14;fontStyle=1;fontColor=#C2410C;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="920" y="2270" width="270" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="e2_gate_denied" value="DENY / NEEDS_EVIDENCE / NEEDS_CONFIRMATION&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;零执行；RunResultMapper 返回可解释、安全的下一步&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#DC2626;fillColor=#FEF2F2;fontSize=14;fontStyle=1;fontColor=#991B1B;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="130" y="2285" width="520" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e2_ledger" value="绑定语义幂等身份并检查 Action Ledger&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;同一用户 + 订单 + 动作语义只允许一个有效执行记录&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFF7ED;fontSize=15;fontStyle=1;fontColor=#9A3412;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="710" y="2440" width="690" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="e2_ledger_state" value="同语义 Action Record 状态？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="900" y="2580" width="310" height="135" as="geometry"/>
        </mxCell>

        <mxCell id="e2_existing" value="COMPLETED / RECONCILED&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;返回既有外部结果引用，不重复执行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=14;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="120" y="2770" width="450" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e2_execute" value="新记录 · 调用 create_refund（Mock）&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;Action Ledger 先追加 STARTED，再携带同一 idempotency_key 执行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFF7ED;fontSize=14;fontStyle=1;fontColor=#9A3412;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="700" y="2770" width="520" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e2_reconcile" value="STARTED / RESULT_UNKNOWN&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;使用原幂等身份调用 get_refund_status 对账&lt;br&gt;严禁再次调用 create_refund&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="1450" y="2770" width="510" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e2_action_result" value="执行结果？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFF7ED;fontSize=14;fontStyle=1;fontColor=#C2410C;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="830" y="2910" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="e2_success" value="Mock 结果：COMPLETED / PROCESSING&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;Action Ledger 保存外部结果引用；返回退款编号、金额和当前状态&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=14;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="410" y="3080" width="400" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="e2_known_failure" value="Action Ledger：FAILED&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;记录明确失败原因和允许的下一步&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontSize=14;fontStyle=1;fontColor=#334155;strokeWidth=1.8;" vertex="1" parent="e2_1">
          <mxGeometry x="855" y="3080" width="350" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="e2_unknown" value="Action Ledger：RESULT_UNKNOWN&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;冻结同语义新执行，转入原身份对账&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="1250" y="3080" width="360" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="e2_mapper" value="Result Processing + Outbound Disclosure Gate + RunResultMapper&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;Observation / Evidence Binding / Action Ledger 按各自记录域追加&lt;br&gt;Task Working Context 仅更新 refs / 最小投影；同步 Conversation / Trace / Context Manifest&lt;br&gt;安全映射资格解释、确认请求、执行结果、状态进展或拒绝&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0F766E;fillColor=#F0FDFA;fontSize=15;fontStyle=1;fontColor=#115E59;strokeWidth=2;" vertex="1" parent="e2_1">
          <mxGeometry x="600" y="3220" width="900" height="125" as="geometry"/>
        </mxCell>

        <mxCell id="e2_rules" value="&lt;b&gt;模拟退款写操作的确定性边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;① 归属门：所有读写都先限定当前用户资源&lt;br&gt;&lt;br&gt;② 输入门：关键 Observation 当前有效；政策 Evidence 可追溯、适用且无冲突&lt;br&gt;&lt;br&gt;③ 资格门：只接受确定性 Eligibility 结果&lt;br&gt;&lt;br&gt;④ 确认门：确认绑定含数量与影响的不可变方案及有效期&lt;br&gt;&lt;br&gt;⑤ 授权门：执行前重新检查身份、归属和权限&lt;br&gt;&lt;br&gt;⑥ 幂等门：重复确认只产生一个有效执行&lt;br&gt;&lt;br&gt;&lt;b&gt;红线：结果未知时只能用原身份对账，禁止盲目重试。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFFBEB;fontSize=13;fontColor=#7C2D12;align=left;verticalAlign=top;spacing=18;strokeWidth=1.8;arcSize=18;" vertex="1" parent="e2_1">
          <mxGeometry x="1490" y="205" width="510" height="570" as="geometry"/>
        </mxCell>

        <mxCell id="e2_e_start_context" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="e2_1" source="e2_start" target="e2_context"><mxGeometry relative="1" as="geometry"/></mxCell>
