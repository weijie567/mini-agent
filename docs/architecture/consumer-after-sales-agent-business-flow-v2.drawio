        <mxCell id="e1_e_diagnosis_no" value="否，只返回物流事实" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#047857;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.55;entryX=1;entryY=0.5;" edge="1" parent="e1_1" source="e1_need_diagnosis" target="e1_mapper_merge_right"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1770" y="1778"/><mxPoint x="1770" y="2050"/></Array></mxGeometry></mxCell>
