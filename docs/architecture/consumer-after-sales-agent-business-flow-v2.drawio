        <mxCell id="e1_e_order_sources_result" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="e1_1" source="e1_order_result_merge" target="e1_order_result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_e_result_multiple" value="多个候选" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#1D4ED8;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.35;entryX=1;entryY=0.45;" edge="1" parent="e1_1" source="e1_order_result" target="e1_ask_candidate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_e_ask_wait" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" parent="e1_1" source="e1_ask_candidate" target="e1_wait_candidate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_e_wait_resume" value="用户确认后恢复" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=1.6;dashed=1;dashPattern=8 5;endArrow=block;endFill=1;fontSize=11;fontColor=#1D4ED8;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="e1_1" source="e1_wait_candidate" target="e1_order_result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_e_result_none" value="无结果 / 无权访问" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=1;entryY=0.35;" edge="1" parent="e1_1" source="e1_order_result" target="e1_safe_not_found"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_e_result_unique" value="唯一且归属通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#047857;labelBackgroundColor=#FFFFFF;" edge="1" parent="e1_1" source="e1_order_result" target="e1_bind_order"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_e_bind_goal" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="e1_1" source="e1_bind_order" target="e1_goal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_e_goal_order" value="订单 / 商品摘要" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#047857;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.55;entryX=0.5;entryY=0;" edge="1" parent="e1_1" source="e1_goal" target="e1_order_details"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1_e_goal_shipment" value="物流 / 配送问题" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#047857;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.55;entryX=0.5;entryY=0;" edge="1" parent="e1_1" source="e1_goal" target="e1_shipment"><mxGeometry relative="1" as="geometry"/></mxCell>
