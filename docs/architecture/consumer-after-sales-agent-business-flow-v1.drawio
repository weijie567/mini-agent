        <mxCell id="p1_e_complete_result" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0284C7;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#0369A1;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="p1_complete" target="p1_result"><mxGeometry relative="1" as="geometry"/></mxCell>
