<mxfile host="app.diagrams.net" modified="2026-07-24T00:00:00.000Z" agent="Codex" version="29.0.3">
  <diagram id="business-flow-overview" name="01 端到端总流程">
    <mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0" background="#F8FAFC">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="p1_title" value="消费者订单与配送售后 Agent｜业务流程 V1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;strokeColor=none;fillColor=none;fontSize=31;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="22" width="1120" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="p1_subtitle" value="Page 1 / 3｜端到端总流程：从登录、理解、动态决策到业务结果" style="text;html=1;align=left;verticalAlign=middle;resizable=0;strokeColor=none;fillColor=none;fontSize=16;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="53" y="70" width="1120" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="p1_badge" value="P0 · SELF-HOSTED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=13;fontStyle=1;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="1650" y="30" width="190" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="p1_legend" value="蓝：用户 / 应用　·　紫：Agent 决策　·　绿：查询 / Evidence　·　橙：副作用动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#475569;fontSize=12;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="1060" y="84" width="780" height="31" as="geometry"/>
        </mxCell>

        <mxCell id="p1_start" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="35" y="170" width="90" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="p1_login" value="&lt;b&gt;1 登录并进入 Agent Chat&lt;/b&gt;&lt;br&gt;消费者提出订单 / 物流 / 退款诉求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1E3A8A;fontSize=13;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="155" y="150" width="255" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="p1_auth" value="&lt;b&gt;2 认证与身份上下文&lt;/b&gt;&lt;br&gt;验证 Session / JWT&lt;br&gt;创建私有 CustomerContext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1E3A8A;fontSize=13;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="150" width="255" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="p1_conversation" value="&lt;b&gt;3 Conversation / Run&lt;/b&gt;&lt;br&gt;创建或恢复会话&lt;br&gt;绑定身份与 Task State" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#38BDF8;strokeWidth=2;fontColor=#0C4A6E;fontSize=13;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="745" y="150" width="255" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="p1_understand" value="&lt;b&gt;4 理解并拆分诉求&lt;/b&gt;&lt;br&gt;RequestUnit Candidate&lt;br&gt;目标 · 参数 · 依赖 · 条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A78BFA;strokeWidth=2;fontColor=#4C1D95;fontSize=13;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="150" width="255" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="p1_react" value="&lt;b&gt;5 Controlled ReAct&lt;/b&gt;&lt;br&gt;依据 Context + Observation&lt;br&gt;提出一个 Structured NextMove" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=13;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1335" y="150" width="275" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="p1_control" value="Control Gateway&lt;br&gt;Schema · Scope · Budget · Stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4B5FD;fontColor=#5B21B6;fontSize=12;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="1645" y="160" width="215" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="p1_nextmove" value="NextMove？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#5B21B6;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="320" width="190" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="p1_ask" value="&lt;b&gt;ASK_USER&lt;/b&gt;&lt;br&gt;缺少参数、确认或需要澄清" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=2;fontColor=#1E3A8A;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="95" y="505" width="285" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="p1_call" value="&lt;b&gt;CALL_TOOL&lt;/b&gt;&lt;br&gt;查询订单 / 物流 / 退款状态&lt;br&gt;检索 Policy Evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#34D399;strokeWidth=2;fontColor=#065F46;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="505" width="315" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="p1_action" value="&lt;b&gt;PROPOSE_ACTION&lt;/b&gt;&lt;br&gt;ActionPolicy 校验后&lt;br&gt;才允许 create_refund" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#9A3412;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="915" y="505" width="315" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="p1_finish" value="&lt;b&gt;FINISH / ESCALATE&lt;/b&gt;&lt;br&gt;完成回答，或返回&lt;br&gt;BLOCKED / NEED_HUMAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;fontColor=#334155;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1340" y="505" width="315" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="p1_ask_detail" value="返回 ASK_USER&lt;br&gt;保存当前 Task State&lt;br&gt;用户补充后恢复 Run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="115" y="665" width="245" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="p1_call_detail" value="&lt;b&gt;查询与 Evidence&lt;/b&gt;&lt;br&gt;ToolResult → Observation&lt;br&gt;&lt;font color=&quot;#047857&quot;&gt;详见 Page 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6EE7B7;strokeWidth=1.5;fontColor=#065F46;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="525" y="665" width="245" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="p1_action_detail" value="&lt;b&gt;受控退款动作&lt;/b&gt;&lt;br&gt;GateDecision → ActionResult&lt;br&gt;&lt;font color=&quot;#C2410C&quot;&gt;详见 Page 3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1.5;fontColor=#9A3412;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="950" y="665" width="245" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="p1_finish_detail" value="RunResultMapper&lt;br&gt;生成最终回答或升级结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1375" y="665" width="245" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="p1_observation" value="&lt;b&gt;Observation + Run / Task State&lt;/b&gt;&lt;br&gt;更新 verified facts、Evidence、结果和预算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6EE7B7;strokeWidth=2;fontColor=#065F46;fontSize=13;arcSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="835" width="410" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="p1_complete" value="目标完成？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#5B21B6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1110" y="820" width="175" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="p1_result" value="RunResultMapper&lt;br&gt;COMPLETED / BLOCKED / NEED_HUMAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#38BDF8;strokeWidth=2;fontColor=#0C4A6E;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="835" width="285" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="p1_end" value="回复消费者" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1710" y="850" width="130" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="p1_crosscut" value="全程记录：RequestUnit · NextMove · GateDecision · ToolCall / Result · Evidence 引用 · Stop Reason　｜　Trace 脱敏并供 Agent Eval 使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FBBF24;fontColor=#92400E;fontSize=12;fontStyle=1;arcSize=25;" vertex="1" parent="1">
          <mxGeometry x="170" y="1000" width="1560" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="p1_e_start_login" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_start" target="p1_login"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e_login_auth" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_login" target="p1_auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e_auth_conv" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0284C7;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_auth" target="p1_conversation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e_conv_understand" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_conversation" target="p1_understand"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e_understand_react" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_understand" target="p1_react"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e_react_control" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_react" target="p1_control"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e_control_next" value="validated NextMove" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#6D28D9;labelBackgroundColor=#F8FAFC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_control" target="p1_nextmove">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1750" y="290"/><mxPoint x="945" y="290"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1_e_next_ask" value="ASK_USER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#1D4ED8;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="p1_nextmove" target="p1_ask"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e_next_call" value="CALL_TOOL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#047857;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="p1_nextmove" target="p1_call"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e_next_action" value="PROPOSE_ACTION" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F97316;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#C2410C;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="p1_nextmove" target="p1_action"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e_next_finish" value="FINISH / ESCALATE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#475569;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="p1_nextmove" target="p1_finish"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e_ask_detail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_ask" target="p1_ask_detail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e_call_detail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_call" target="p1_call_detail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e_action_detail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F97316;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_action" target="p1_action_detail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e_finish_detail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_finish" target="p1_finish_detail"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e_call_obs" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1_call_detail" target="p1_observation"><mxGeometry relative="1" as="geometry"/></mxCell>
