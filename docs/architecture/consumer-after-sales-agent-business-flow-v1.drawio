  <diagram id="business-flow-query-diagnosis-v1" name="02 查询与异常诊断">
    <mxGraphModel dx="1900" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="p2_0"/>
        <mxCell id="p2_1" parent="p2_0"/>

        <mxCell id="p2_title" value="业务流程 V1 · 查询与异常诊断" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="p2_1"><mxGeometry x="70" y="30" width="650" height="38" as="geometry"/></mxCell>
        <mxCell id="p2_subtitle" value="从用户问题到可引用事实：身份约束 → 订单证据 → 物流证据 → 状态解释" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#475569;" vertex="1" parent="p2_1"><mxGeometry x="70" y="69" width="820" height="26" as="geometry"/></mxCell>
        <mxCell id="p2_legend" value="实线 = 本轮执行　　蓝色 = 会话与身份　　绿色 = 工具与证据　　橙色 = 异常诊断　　灰色 = 安全退出　　虚线 = 下一轮会话返回" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#F8FAFC;fontSize=12;fontColor=#334155;align=left;spacingLeft=16;" vertex="1" parent="p2_1"><mxGeometry x="70" y="105" width="1760" height="42" as="geometry"/></mxCell>

        <mxCell id="p2_start" value="用户发起查询&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;“我的快递到哪了？”&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=15;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="p2_1"><mxGeometry x="820" y="175" width="260" height="76" as="geometry"/></mxCell>
        <mxCell id="p2_context" value="校验登录态并装载 CustomerContext&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;customer_id 由服务端注入，不接受模型或用户覆盖&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=15;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="p2_1"><mxGeometry x="760" y="290" width="380" height="84" as="geometry"/></mxCell>
        <mxCell id="p2_order_id" value="订单标识&lt;br&gt;是否明确？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="p2_1"><mxGeometry x="855" y="420" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="p2_ask_order" value="ASK_USER · 请求用户选择订单&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;提供候选订单摘要，不猜测 order_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=14;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="p2_1"><mxGeometry x="200" y="430" width="330" height="82" as="geometry"/></mxCell>
        <mxCell id="p2_wait_order" value="等待用户补充&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#64748B&quot;&gt;状态：WAITING_FOR_USER&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontSize=14;fontStyle=1;fontColor=#334155;strokeWidth=1.8;" vertex="1" parent="p2_1"><mxGeometry x="230" y="550" width="270" height="72" as="geometry"/></mxCell>

        <mxCell id="p2_get_order" value="调用 get_order&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;输入：server customer_id + selected order_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=15;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="p2_1"><mxGeometry x="760" y="570" width="380" height="82" as="geometry"/></mxCell>
        <mxCell id="p2_order_access" value="订单存在且&lt;br&gt;归属当前用户？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="p2_1"><mxGeometry x="850" y="700" width="200" height="105" as="geometry"/></mxCell>
        <mxCell id="p2_safe_not_found" value="安全结果&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;NOT_FOUND / NOT_ACCESSIBLE&lt;br&gt;不泄露订单是否属于他人&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontSize=14;fontStyle=1;fontColor=#334155;strokeWidth=1.8;" vertex="1" parent="p2_1"><mxGeometry x="190" y="710" width="340" height="86" as="geometry"/></mxCell>

        <mxCell id="p2_get_shipment" value="调用 get_shipment&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;以已验证订单关系查询物流轨迹与预计送达时间&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=15;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="p2_1"><mxGeometry x="760" y="855" width="380" height="82" as="geometry"/></mxCell>
        <mxCell id="p2_tool_ok" value="工具调用&lt;br&gt;成功？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="p2_1"><mxGeometry x="855" y="985" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="p2_tool_failure" value="标准化失败处理&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;按失败类型有限重试；超预算则 BLOCKED / ESCALATE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontSize=14;fontStyle=1;fontColor=#334155;strokeWidth=1.8;" vertex="1" parent="p2_1"><mxGeometry x="170" y="995" width="380" height="82" as="geometry"/></mxCell>

        <mxCell id="p2_evidence" value="标准化 ToolResult + Evidence&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;记录 source / timestamp / request_id；写入短期任务记忆&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=15;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="p2_1"><mxGeometry x="730" y="1135" width="440" height="88" as="geometry"/></mxCell>
        <mxCell id="p2_status" value="物流状态&lt;br&gt;属于哪类？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFF7ED;fontSize=14;fontStyle=1;fontColor=#C2410C;strokeWidth=2;" vertex="1" parent="p2_1"><mxGeometry x="845" y="1270" width="210" height="110" as="geometry"/></mxCell>

        <mxCell id="p2_normal" value="正常在途 / 已签收&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;说明当前节点、更新时间与 ETA&lt;br&gt;只陈述证据支持的事实&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=14;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="p2_1"><mxGeometry x="390" y="1435" width="360" height="92" as="geometry"/></mxCell>
        <mxCell id="p2_exception" value="异常诊断&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;延迟 / 长时间无更新 / 签收未收到&lt;br&gt;解释依据，并给出可执行下一步&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFF7ED;fontSize=14;fontStyle=1;fontColor=#9A3412;strokeWidth=2;" vertex="1" parent="p2_1"><mxGeometry x="1150" y="1435" width="390" height="92" as="geometry"/></mxCell>
        <mxCell id="p2_response" value="Result Mapper 生成用户答复&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;结论 + 证据时间 + 下一步；同步 Conversation / Task State / Trace&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=15;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="p2_1"><mxGeometry x="690" y="1580" width="520" height="88" as="geometry"/></mxCell>
        <mxCell id="p2_end" value="回复用户" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#DBEAFE;fontSize=15;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="p2_1"><mxGeometry x="850" y="1710" width="200" height="58" as="geometry"/></mxCell>

        <mxCell id="p2_rules" value="&lt;b&gt;本页关键业务规则&lt;/b&gt;&lt;br&gt;&lt;br&gt;① customer_id 只能来自服务端身份上下文&lt;br&gt;&lt;br&gt;② 模型摘要、用户自述不是已验证事实&lt;br&gt;&lt;br&gt;③ 工具输出必须标准化为 ToolResult&lt;br&gt;&lt;br&gt;④ 异常诊断要引用轨迹时间，不能凭常识补全&lt;br&gt;&lt;br&gt;⑤ 查询不成功时安全退出，不跨用户试探" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#94A3B8;fillColor=#FFFFFF;fontSize=13;fontColor=#334155;align=left;verticalAlign=top;spacing=18;strokeWidth=1.5;" vertex="1" parent="p2_1"><mxGeometry x="1380" y="240" width="410" height="430" as="geometry"/></mxCell>
        <mxCell id="p2_ref" value="承接第 1 页的 CALL_TOOL&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#64748B&quot;&gt;若查询中形成退款意图，转入第 3 页&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#F8FAFC;fontSize=13;fontStyle=1;fontColor=#475569;strokeWidth=1.5;" vertex="1" parent="p2_1"><mxGeometry x="1380" y="710" width="410" height="78" as="geometry"/></mxCell>

        <mxCell id="p2_e_start_context" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="p2_1" source="p2_start" target="p2_context"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_context_orderid" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="p2_1" source="p2_context" target="p2_order_id"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_orderid_ask" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#1D4ED8;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="p2_1" source="p2_order_id" target="p2_ask_order"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_ask_wait" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=1.8;endArrow=block;endFill=1;" edge="1" parent="p2_1" source="p2_ask_order" target="p2_wait_order"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_wait_return" value="用户补充后进入下一轮" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=1.6;dashed=1;dashPattern=8 5;endArrow=block;endFill=1;fontSize=11;fontColor=#1D4ED8;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="p2_1" source="p2_wait_order" target="p2_order_id">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="586"/><mxPoint x="650" y="495"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="p2_e_orderid_getorder" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#047857;labelBackgroundColor=#FFFFFF;" edge="1" parent="p2_1" source="p2_order_id" target="p2_get_order"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_getorder_access" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="p2_1" source="p2_get_order" target="p2_order_access"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_access_safe" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="p2_1" source="p2_order_access" target="p2_safe_not_found"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_access_shipment" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#047857;labelBackgroundColor=#FFFFFF;" edge="1" parent="p2_1" source="p2_order_access" target="p2_get_shipment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_shipment_ok" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="p2_1" source="p2_get_shipment" target="p2_tool_ok"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_ok_failure" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="p2_1" source="p2_tool_ok" target="p2_tool_failure"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_ok_evidence" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#047857;labelBackgroundColor=#FFFFFF;" edge="1" parent="p2_1" source="p2_tool_ok" target="p2_evidence"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_evidence_status" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F97316;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="p2_1" source="p2_evidence" target="p2_status"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_status_normal" value="正常" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#047857;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.3;" edge="1" parent="p2_1" source="p2_status" target="p2_normal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_status_exception" value="异常" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F97316;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontColor=#C2410C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="p2_1" source="p2_status" target="p2_exception"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_normal_response" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="p2_1" source="p2_normal" target="p2_response"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_exception_response" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F97316;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="p2_1" source="p2_exception" target="p2_response"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2_e_response_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="p2_1" source="p2_response" target="p2_end"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="business-flow-refund-recovery-v1" name="03 退款与结果恢复">
    <mxGraphModel dx="1900" dy="2100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="p3_0"/>
        <mxCell id="p3_1" parent="p3_0"/>

        <mxCell id="p3_title" value="业务流程 V1 · 退款与未知结果恢复" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="p3_1"><mxGeometry x="70" y="30" width="720" height="38" as="geometry"/></mxCell>
        <mxCell id="p3_subtitle" value="写操作只走受控动作通道：有效证据 → 资格判断 → 明确确认 → 授权校验 → 幂等执行 → 结果对账" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#475569;" vertex="1" parent="p3_1"><mxGeometry x="70" y="69" width="980" height="26" as="geometry"/></mxCell>
        <mxCell id="p3_legend" value="绿色 = 已验证证据　　橙色 = 受控写操作　　紫色 = 业务决策　　蓝色 = 用户确认　　红色 = 禁止执行　　虚线 = 恢复 / 下一轮会话" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#F8FAFC;fontSize=12;fontColor=#334155;align=left;spacingLeft=16;" vertex="1" parent="p3_1"><mxGeometry x="70" y="105" width="1760" height="42" as="geometry"/></mxCell>

        <mxCell id="p3_start" value="用户提出退款诉求" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=15;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="825" y="175" width="250" height="64" as="geometry"/></mxCell>
        <mxCell id="p3_order_evidence" value="装载已验证的订单 / 物流证据&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;订单归属、支付状态、履约状态、关键时间点&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=15;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="740" y="280" width="420" height="82" as="geometry"/></mxCell>
        <mxCell id="p3_policy" value="检索并引用退款政策证据&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;规则版本、适用范围、时效与例外条件&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=15;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="740" y="400" width="420" height="82" as="geometry"/></mxCell>
        <mxCell id="p3_evidence_valid" value="证据新鲜、完整&lt;br&gt;且无冲突？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="845" y="530" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="p3_refresh" value="刷新 / 补齐证据&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;重新查询订单、物流或政策；仍不满足则 BLOCKED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontSize=14;fontStyle=1;fontColor=#334155;strokeWidth=1.8;" vertex="1" parent="p3_1"><mxGeometry x="170" y="545" width="390" height="86" as="geometry"/></mxCell>

        <mxCell id="p3_eligible" value="满足退款资格？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="850" y="690" width="200" height="105" as="geometry"/></mxCell>
        <mxCell id="p3_ineligible" value="不执行退款&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;解释适用政策、证据与可选替代方案&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#DC2626;fillColor=#FEF2F2;fontSize=14;fontStyle=1;fontColor=#991B1B;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="190" y="700" width="350" height="82" as="geometry"/></mxCell>

        <mxCell id="p3_proposal" value="生成不可变 ActionProposal&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;order_id · refund_amount · reason · policy_evidence · expires_at&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFF7ED;fontSize=15;fontStyle=1;fontColor=#9A3412;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="700" y="845" width="500" height="86" as="geometry"/></mxCell>
        <mxCell id="p3_confirmed" value="用户是否对该提案&lt;br&gt;作出明确确认？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=14;fontStyle=1;fontColor=#1D4ED8;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="835" y="980" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="p3_ask_confirm" value="ASK_USER · 展示确认摘要&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;明确金额、订单、原因与不可逆影响&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=14;fontStyle=1;fontColor=#1E3A8A;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="170" y="970" width="390" height="84" as="geometry"/></mxCell>
        <mxCell id="p3_wait_confirm" value="等待精确确认&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#64748B&quot;&gt;未确认、含糊确认或提案过期：绝不执行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontSize=14;fontStyle=1;fontColor=#334155;strokeWidth=1.8;" vertex="1" parent="p3_1"><mxGeometry x="200" y="1095" width="330" height="76" as="geometry"/></mxCell>

        <mxCell id="p3_authorized" value="身份、订单归属与&lt;br&gt;动作授权仍有效？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="835" y="1145" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="p3_denied" value="拒绝执行并安全回复&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;AUTH_DENIED / OWNERSHIP_MISMATCH / PROPOSAL_EXPIRED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#DC2626;fillColor=#FEF2F2;fontSize=14;fontStyle=1;fontColor=#991B1B;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="170" y="1230" width="390" height="84" as="geometry"/></mxCell>

        <mxCell id="p3_idempotency" value="生成语义幂等键并检查 Action Ledger&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;同一用户 + 订单 + 动作语义只允许一个有效执行记录&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFF7ED;fontSize=15;fontStyle=1;fontColor=#9A3412;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="700" y="1310" width="500" height="88" as="geometry"/></mxCell>
        <mxCell id="p3_ledger_state" value="Ledger 当前状态？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="835" y="1450" width="230" height="115" as="geometry"/></mxCell>

        <mxCell id="p3_existing" value="SUCCEEDED&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;返回既有退款结果&lt;br&gt;不重复扣减或退款&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=14;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="120" y="1620" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="p3_execute" value="NEW · 调用 create_refund&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;携带同一 idempotency_key；先写 PENDING 再执行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFF7ED;fontSize=14;fontStyle=1;fontColor=#9A3412;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="680" y="1620" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="p3_reconcile" value="PENDING / RESULT_UNKNOWN&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;调用 get_refund_status 对账&lt;br&gt;严禁盲目重试 create_refund&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="1380" y="1620" width="380" height="90" as="geometry"/></mxCell>

        <mxCell id="p3_action_result" value="执行结果？" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFF7ED;fontSize=14;fontStyle=1;fontColor=#C2410C;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="795" y="1760" width="190" height="105" as="geometry"/></mxCell>
        <mxCell id="p3_success" value="SUCCEEDED&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;保存退款单号与金额&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#059669;fillColor=#ECFDF5;fontSize=14;fontStyle=1;fontColor=#065F46;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="470" y="1900" width="270" height="76" as="geometry"/></mxCell>
        <mxCell id="p3_known_failure" value="KNOWN_FAILURE&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;记录失败原因并告知用户&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#F8FAFC;fontSize=14;fontStyle=1;fontColor=#334155;strokeWidth=1.8;" vertex="1" parent="p3_1"><mxGeometry x="820" y="1900" width="280" height="76" as="geometry"/></mxCell>
        <mxCell id="p3_unknown" value="UNKNOWN / 超时&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;标记 RESULT_UNKNOWN，转入对账&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="1160" y="1900" width="310" height="76" as="geometry"/></mxCell>
        <mxCell id="p3_reconcile_result" value="对账后返回真实状态&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;仍未知则保持 WAITING / RESULT_UNKNOWN，稍后继续对账&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#7C3AED;fillColor=#F5F3FF;fontSize=14;fontStyle=1;fontColor=#5B21B6;strokeWidth=2;" vertex="1" parent="p3_1"><mxGeometry x="1490" y="1800" width="320" height="94" as="geometry"/></mxCell>

        <mxCell id="p3_footer" value="所有终态统一落盘：ActionRecord / Conversation / Task State / Trace　→　Result Mapper 生成可解释答复" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0F766E;fillColor=#F0FDFA;fontSize=14;fontStyle=1;fontColor=#115E59;strokeWidth=1.8;" vertex="1" parent="p3_1"><mxGeometry x="100" y="2020" width="1700" height="52" as="geometry"/></mxCell>

        <mxCell id="p3_rules" value="&lt;b&gt;退款动作的四道门&lt;/b&gt;&lt;br&gt;&lt;br&gt;① 证据门：事实与政策可引用且仍有效&lt;br&gt;&lt;br&gt;② 确认门：用户确认必须精确匹配当前提案&lt;br&gt;&lt;br&gt;③ 授权门：身份、归属和权限在执行前再次校验&lt;br&gt;&lt;br&gt;④ 幂等门：重复确认只执行一次&lt;br&gt;&lt;br&gt;&lt;b&gt;红线：结果未知时，不得盲目重试写操作。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F97316;fillColor=#FFFBEB;fontSize=13;fontColor=#7C2D12;align=left;verticalAlign=top;spacing=18;strokeWidth=1.6;" vertex="1" parent="p3_1"><mxGeometry x="1370" y="250" width="420" height="450" as="geometry"/></mxCell>
        <mxCell id="p3_ref" value="承接第 1 页的 PROPOSE_ACTION&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#64748B&quot;&gt;查询证据来自第 2 页，写操作不绕过 Control Gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#F8FAFC;fontSize=13;fontStyle=1;fontColor=#475569;strokeWidth=1.5;" vertex="1" parent="p3_1"><mxGeometry x="1370" y="740" width="420" height="82" as="geometry"/></mxCell>

